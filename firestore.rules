rules_version = '2';
// قواعد أمان قاعدة البيانات - انسخها إلى Firebase Console ← Firestore ← Rules
// مهم: غيّر البريد التالي إلى بريد حساب المدير الذي أنشأته في Authentication
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "admin@example.com";
    }

    // المنتجات والإعدادات: يقرأها الجميع، ويعدّلها المدير فقط
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الزيارات: أي زائر يسجّل زيارته، والمدير فقط يقرأ
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(
        ['vid', 't', 'deviceType', 'os', 'browser', 'model', 'screen', 'phone', 'ref']);
      allow read, delete: if isAdmin();
    }

    // الزبائن: التسجيل والتحديث من المتجر، والقراءة والحذف للمدير فقط
    match /customers/{phone} {
      allow create: if request.resource.data.phone == phone
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100;
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['name', 'lastSeen', 'visits', 'deviceType', 'os', 'browser', 'model', 'screen']);
      allow read, delete: if isAdmin();
    }

    // الطلبات: الزبون ينشئ طلباً، والمدير يقرأ ويعدّل ويحذف
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}
